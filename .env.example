# .env.example — Template for required environment variables.
# Copy this to .env and fill in your real values.
# NEVER commit the .env file — it is in .gitignore.

# ── AI Reply (Groq) ───────────────────────────────────────────────────────────
# Get a free key at: https://console.groq.com
# Without this key, the /ticket/reply endpoint still works but returns
# a static fallback reply instead of an AI-generated one.
GROQ_API_KEY=your_groq_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Optional: override the SQLite database path (default: ./support.db)
# For production, you could switch to PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///./support.db

# ── ServiceNow Integration (Optional) ─────────────────────────────────────────
# Enable automatic incident routing to your ServiceNow PDI.
# Set these variables in your local .env file.
SERVICENOW_INSTANCE=https://dev390619.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASS=your_pdi_admin_password
SERVICENOW_SCOPE=x_2179494_ai_inc_0


# ── Computer Vision (Optional) ────────────────────────────────────────────────
# Set to 'true' to enable the YOLOv8 object detection model on ticket images.
# This lazily loads a ~6MB YOLOv8n model into memory on the first image request.
ENABLE_COMPUTER_VISION=false
